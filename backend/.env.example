# Copy to .env in backend/. Health works without a database; documents require one.
TRACERAG_APP_NAME=TraceRAG
TRACERAG_ENVIRONMENT=development
# Replace the password before uncommenting. Upload, indexing, and search do not need Gemini.
# TRACERAG_DATABASE_URL=postgresql+psycopg://tracerag:REPLACE_ME@127.0.0.1:55432/tracerag
TRACERAG_MAX_UPLOAD_BYTES=10485760
TRACERAG_MAX_PDF_PAGES=100
TRACERAG_MAX_TEXT_CHARS=2000000
TRACERAG_PARSE_TIMEOUT_SECONDS=20
TRACERAG_CHUNK_SIZE=1000
TRACERAG_CHUNK_OVERLAP=200
TRACERAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRACERAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
TRACERAG_EMBEDDING_DIMENSIONS=384
TRACERAG_EMBEDDING_MAX_TOKENS=256
TRACERAG_EMBEDDING_BATCH_SIZE=16
# Set true after caching model files to prevent network downloads at runtime.
TRACERAG_EMBEDDING_LOCAL_FILES_ONLY=false

# Optional for upload/search; required for answers. Keep the real key private.
TRACERAG_GEMINI_API_KEY=
TRACERAG_LLM_MODEL=gemini-3.8-flash
TRACERAG_LLM_TIMEOUT_SECONDS=30
TRACERAG_LLM_MAX_OUTPUT_TOKENS=2048
TRACERAG_QA_CONTEXT_CHARS=12000
